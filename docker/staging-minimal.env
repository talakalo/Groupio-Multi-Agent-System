# Groupio Web App Environment Variables

# API Configuration
# אם נכנסת דרך 127.0.0.1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
GF_SECURITY_ADMIN_PASSWORD=change-me-local-admin-password
# או אם נכנסת דרך localhost
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=replace-with-supabase-publishable-key
ANON_KEY=replace-with-supabase-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-char-nextauth-secret

# WhatsApp Integration (optional)
NEXT_PUBLIC_WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_PHONE=

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Sentry Error Tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Locale Settings
NEXT_PUBLIC_DEFAULT_LOCALE=he
NEXT_PUBLIC_SUPPORTED_LOCALES=he,en
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://localhost:3001"]
# API Keys
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=replace-with-openai-api-key

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-qdrant-api-key

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Database (for Alembic migrations)
# Local PostgreSQL (default):
# Supabase: get from Dashboard → Project Settings → Database → Connection string
DATABASE_URL='postgresql://postgres:replace-with-db-password@localhost:5432/groupio'
# DATABASE_URL=postgresql://postgres:replace-with-db-password@db.your-project.supabase.co:5432/postgres
PINECONE_API_KEY=replace-with-pinecone-api-key
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
RESEND_API_KEY=replace-with-resend-api-key
SMTP_FROM_EMAIL=noreply@groupio   # or your verified domain address
SMTP_FROM_NAME=Groupio
FRONTEND_URL=http://localhost:3000      # links in emails must hit your local web app
ENVIRONMENT=development 

ENABLE_RABBITMQ=true
ENABLE_OUTBOX=true
ENABLE_NOTIFICATION_QUEUE=true
ENABLE_CRM_SYNC=true
ENABLE_PAYMENT_EVENTS=true
#NEO4J_USER=neo4j   
#NEO4J_URI=bolt://localhost:7687
QDRANT_PREFER_GRPC=true
#postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_USER=postgres
POSTGRES_DB=groupio
# Redis
# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-supabase-key
SUPABASE_DB_PASSWORD=replace-with-supabase-db-password
# Redis (127.0.0.1 avoids IPv6 errno 99; password for Docker Redis)
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379

# LLM Settings
PRIMARY_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-large
MAX_TOKENS=800
TEMPERATURE=0.7

# RAG Settings
VECTOR_TOP_K=10
RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Agent Settings
ROUTER_CONFIDENCE_THRESHOLD=0.7
HUMAN_ESCALATION_ENABLED=true

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_GRAPH_QUERIES=true
ENABLE_PREDICTIVE_MODELS=false

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
# Use local PostgreSQL instead of Supabase (set to 1 when Supabase has connection issues)
USE_LOCAL_POSTGRES=1

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# API Keys for service-to-service authentication
API_KEYS=["replace-with-service-api-key-1","replace-with-service-api-key-2"]

# JWT Authentication
JWT_SECRET_KEY=replace-with-32-char-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
USE_LOCAL_POSTGRES=1

# WhatsApp Business API
WHATSAPP_API_TOKEN=replace-with-whatsapp-api-token
WHATSAPP_PHONE_ID=120363945040864
WHATSAPP_WEBHOOK_SECRET=replace-with-whatsapp-webhook-secret


# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dev@groupio.co.il
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@groupio.co.il
SMTP_FROM_NAME=Groupio

# Government / open-data enrichment (optional; stub used when empty)
GOV_ADDRESS_API_URL=
GOV_CONTRACTOR_API_URL=
GOV_MUNICIPALITY_API_URL=
# Phase 3: data.gov.il integration. Set to "1" or "true" to enable.
ENABLE_DATAGOV_IL=1

# Rate Limiting
RATE_LIMIT_PER_USER=10
RATE_LIMIT_WINDOW=10

# Stripe — test mode
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# Tracked defaults for Docker Compose (local / CI compose validation only).
# For production or shared staging, copy to a private env file and replace every secret.
#
# Compose interpolation (required for `docker compose config`):
#   docker compose --env-file docker/staging-minimal.env -f docker/docker-compose.yml config
# Bring-up (from repo root):
#   docker compose --env-file docker/staging-minimal.env -f docker/docker-compose.yml up -d postgres rabbitmq redis qdrant neo4j api

POSTGRES_PASSWORD=local-dev-postgres-not-for-production
POSTGRES_USER=postgres
POSTGRES_DB=groupio
NEO4J_PASSWORD=local-dev-neo4j-not-for-production
REDIS_PASSWORD=groupio-redis-dev
ANTHROPIC_API_KEY=placeholder
OPENAI_API_KEY=placeholder
SUPABASE_URL=https://placeholder.invalid
SUPABASE_KEY=placeholder
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SLACK_WEBHOOK_URL=https://example.com/alertmanager-noop

# App (passed into containers via env_file)
USE_LOCAL_POSTGRES=1
DATABASE_URL=postgresql://postgres:local-dev-postgres-not-for-production@postgres:5432/groupio
REDIS_URL=redis://:groupio-redis-dev@redis:6379
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
ENVIRONMENT=development
LOG_LEVEL=INFO
ENFORCE_EMAIL_VERIFICATION=false
JWT_SECRET_KEY=local-docker-jwt-secret-replace-in-real-staging-min-32-chars
JWT_ALGORITHM=HS256
API_KEYS=["local-docker-api-key"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
PAYMENT_PROVIDER=mock
ENABLE_WEB_SEARCH=false
ENABLE_GRAPH_QUERIES=false
ENABLE_PREDICTIVE_MODELS=false

# Async stack (enable after broker healthy)
ENABLE_RABBITMQ=false
ENABLE_OUTBOX=false
ENABLE_NOTIFICATION_QUEUE=false
ENABLE_CRM_SYNC=false
ENABLE_PAYMENT_EVENTS=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE_EVENTS=groupio.events
OUTBOX_POLL_INTERVAL_MS=500
ESPOCRM_BASE_URL=
ESPOCRM_API_KEY=
ESPOCRM_ENTITY_CONTRACTOR=C_GroupioContractor
ESPOCRM_ENTITY_BUILDING=C_GroupioBuilding
ESPOCRM_ENTITY_NOTE=Note
ESPOCRM_FIELD_CONTRACTOR_EXTERNAL_ID=cGroupioContractorId
ESPOCRM_FIELD_CONTRACTOR_VERIFICATION=cGroupioVerificationStatus
ESPOCRM_FIELD_BUILDING_EXTERNAL_ID=cGroupioBuildingId
ESPOCRM_FIELD_BUILDING_ADDRESS=cGroupioAddress
ESPOCRM_FIELD_BUILDING_CITY=cGroupioCity
ESPOCRM_FIELD_BUILDING_REGION=cGroupioRegion

FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
GF_SECURITY_ADMIN_PASSWORD=local-grafana-dev-not-for-production

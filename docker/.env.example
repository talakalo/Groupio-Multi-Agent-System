# API Keys
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-proj---

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=

# Database (for Alembic migrations)
# Local PostgreSQL (default):
DATABASE_URL=:groupio
# Supabase: get from Dashboard → Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#NEO4J_PASSWORD=testpassword
#NEO4J_USER=neo4j   
#NEO4J_URI=bolt://localhost:7687

# Redis
# Supabase
SUPABASE_KEY=
SUPABASE_DB_PASSWORD=
# Redis
REDIS_URL=redis://localhost:6379

# LLM Settings
PRIMARY_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-large
MAX_TOKENS=800
TEMPERATURE=0.7

# RAG Settings
VECTOR_TOP_K=10
RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Agent Settings
ROUTER_CONFIDENCE_THRESHOLD=0.7
HUMAN_ESCALATION_ENABLED=true

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_GRAPH_QUERIES=true
ENABLE_PREDICTIVE_MODELS=false

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=production

# Use local PostgreSQL instead of Supabase (set to 1 when Supabase has connection issues)
USE_LOCAL_POSTGRES=1

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=["https://groupio.co.il","https://admin.groupio.co.il","http://localhost:3000","http://localhost:3001"]

# API Keys for service-to-service authentication
API_KEYS=["",""]

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# WhatsApp Business API
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dev@groupio.co.il
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@groupio.co.il
SMTP_FROM_NAME=Groupio

# Rate Limiting
RATE_LIMIT_PER_USER=60
RATE_LIMIT_WINDOW=60
ENVIRONMENT=development
# API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Use REST by default (gRPC port 6334 often unavailable in local Docker)
# QDRANT_PREFER_GRPC=false

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# Database (for Alembic migrations)
# Local PostgreSQL (default). When USE_LOCAL_POSTGRES=1 and running in Docker,
# the API uses DOCKER_DATABASE_URL (postgres service) — set by docker-compose.
# For local dev (non-Docker), use localhost:
DATABASE_URL=postgresql://postgres:change-me-db-password@localhost:5432/groupio
# Supabase: get from Dashboard → Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase (optional – only needed if using hosted Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
# Client-safe publishable key (sb_publishable_…) for browsers; do not use alone for seed_test_data.
SUPABASE_KEY=your-supabase-publishable-or-anon-key
# Server key for seeding / backend: new **secret** (sb_secret_…) or legacy service_role JWT (eyJ…).
# Dashboard → Settings → API Keys (secret) or Legacy API Keys (service_role).
SUPABASE_SERVICE_ROLE_KEY=
# Same JWT as above if you prefer this name (optional)
SERVICE_ROLE_KEY=
# Alternate name for sb_secret_… / server key (optional)
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Redis (use 127.0.0.1 not localhost — avoids IPv6 errno 99 on macOS)
REDIS_URL=redis://:groupio-redis-dev@127.0.0.1:6379
REDIS_PASSWORD=groupio-redis-dev

# LLM Settings
PRIMARY_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-large
MAX_TOKENS=800
TEMPERATURE=0.7

# RAG Settings
VECTOR_TOP_K=10
RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Agent Settings
ROUTER_CONFIDENCE_THRESHOLD=0.7
HUMAN_ESCALATION_ENABLED=true

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_GRAPH_QUERIES=true
ENABLE_PREDICTIVE_MODELS=false

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Use local PostgreSQL instead of Supabase (set to 1 when Supabase has connection issues)
USE_LOCAL_POSTGRES=1

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# API Keys for service-to-service authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEYS=["generate-a-secure-key-here"]

# JWT Authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=generate-a-64-char-hex-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# WhatsApp Business API
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# Email (verification links use FRONTEND_URL below)
# Option 1 — Resend (recommended): https://resend.com/api-keys
# Use a from-address domain you verified in Resend (SMTP_FROM_EMAIL).
# When RESEND_API_KEY is set, SMTP_HOST / SMTP_USER / SMTP_PASSWORD are ignored for sending.
RESEND_API_KEY=
SMTP_FROM_EMAIL=noreply@groupio# or your verified domain address
SMTP_FROM_NAME=Groupio
FRONTEND_URL=http://localhost:3000      # links in emails must hit your local web app
ENVIRONMENT=development                  
# Option 2 — SMTP (local dev without Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=noreply@groupio.co.il
SMTP_FROM_NAME=Groupio

# Base URL for links in emails (verify-email, password reset). Must match your deployed web app.
# FRONTEND_URL=https://your-app.example.com
# ENFORCE_EMAIL_VERIFICATION=true

# Rate Limiting
RATE_LIMIT_PER_USER=60
RATE_LIMIT_WINDOW=60

# ──────────────────────────────────────────────────────────────────────────────
# Payment Provider Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Selects the active payment provider.
# Allowed values: mock | stripe | bit | paybox
PAYMENT_PROVIDER=mock

# Stripe credentials (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Generic payment webhook HMAC secret
PAYMENT_WEBHOOK_SECRET=

# bit (NOT YET LIVE — see docs/PAYMENT_PROVIDER_ONBOARDING.md)
ENABLE_BIT_PAYMENT=false
BIT_API_KEY=
BIT_MERCHANT_ID=
BIT_ENVIRONMENT=sandbox

# PayBox (NOT YET LIVE — see docs/PAYMENT_PROVIDER_ONBOARDING.md)
ENABLE_PAYBOX_PAYMENT=false
PAYBOX_TERMINAL=
PAYBOX_API_KEY=
PAYBOX_ENVIRONMENT=sandbox

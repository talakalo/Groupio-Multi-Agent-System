# Groupio Multi-Agent System
# Docker Compose: use `docker/staging-minimal.env` and
#   docker compose --env-file docker/staging-minimal.env -f docker/docker-compose.yml config
# (see docs/STAGING_ASYNC_ROLLOUT.md).

# API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# Qdrant (default vector DB — self-hosted)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Vector DB provider: "qdrant" (default) or "pinecone" (managed cloud)
VECTOR_DB_PROVIDER=qdrant
# Pinecone (required when VECTOR_DB_PROVIDER=pinecone)
# Get API key from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=
PINECONE_INDEX_NAME=groupio
PINECONE_ENVIRONMENT=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# Database (for Alembic migrations)
# Local PostgreSQL (default):
DATABASE_URL=postgresql://postgres:change-me-db-password@localhost:5432/groupio
# Supabase: get from Dashboard → Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase (optional – only needed if using hosted Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Redis
REDIS_URL=redis://localhost:6379

# LLM Settings
PRIMARY_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-large
MAX_TOKENS=800
TEMPERATURE=0.7

# RAG Settings
VECTOR_TOP_K=10
RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Agent Settings
ROUTER_CONFIDENCE_THRESHOLD=0.7
HUMAN_ESCALATION_ENABLED=true

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_GRAPH_QUERIES=true
ENABLE_PREDICTIVE_MODELS=false

# Async events / RabbitMQ / EspoCRM (safe defaults: all off)
# See docs/ASYNC_EVENTS_RUNBOOK.md
ENABLE_RABBITMQ=false
ENABLE_OUTBOX=false
ENABLE_NOTIFICATION_QUEUE=false
ENABLE_CRM_SYNC=false
ENABLE_PAYMENT_EVENTS=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_EVENTS=groupio.events
OUTBOX_POLL_INTERVAL_MS=500
ESPOCRM_BASE_URL=
ESPOCRM_API_KEY=
# Espo entity types + field attribute names (must match your Espo admin schema)
ESPOCRM_ENTITY_CONTRACTOR=C_GroupioContractor
ESPOCRM_ENTITY_BUILDING=C_GroupioBuilding
ESPOCRM_ENTITY_NOTE=Note
ESPOCRM_FIELD_CONTRACTOR_EXTERNAL_ID=cGroupioContractorId
ESPOCRM_FIELD_CONTRACTOR_VERIFICATION=cGroupioVerificationStatus
ESPOCRM_FIELD_BUILDING_EXTERNAL_ID=cGroupioBuildingId
ESPOCRM_FIELD_BUILDING_ADDRESS=cGroupioAddress
ESPOCRM_FIELD_BUILDING_CITY=cGroupioCity
ESPOCRM_FIELD_BUILDING_REGION=cGroupioRegion

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Use local PostgreSQL instead of Supabase (set to 1 when Supabase has connection issues)
USE_LOCAL_POSTGRES=1

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# API Keys for service-to-service authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEYS=["generate-a-secure-key-here"]

# JWT Authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=generate-a-64-char-hex-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# WhatsApp Business API
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# Email Settings
# Shared sender identity (used by both Resend and SMTP transports)
SMTP_FROM_EMAIL=noreply@groupio.co.il   # must match your verified sending domain
SMTP_FROM_NAME=Groupio
FRONTEND_URL=http://localhost:3000      # links in emails must hit your local web app

# Option 1 — Resend (recommended for production, higher deliverability)
# Get API key from: https://resend.com/api-keys
# When RESEND_API_KEY is set, SMTP_HOST/SMTP_USER/SMTP_PASSWORD are ignored for sending.
RESEND_API_KEY=re_your_resend_api_key_here

# Option 2 — SMTP (fallback for local development without a Resend key)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password

# Rate Limiting
RATE_LIMIT_PER_USER=60
RATE_LIMIT_WINDOW=60

# ──────────────────────────────────────────────────────────────────────────────
# Payment Provider Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Selects the active payment provider.
# Allowed values:
#   mock   — simulated provider for local dev / demos only (BLOCKED in production)
#   stripe — Stripe credit card processing (requires STRIPE_SECRET_KEY)
#   bit    — bit payment link flow (requires BIT_API_KEY — NOT YET LIVE)
#   paybox — PayBox redirect flow (requires PAYBOX_TERMINAL + PAYBOX_API_KEY — NOT YET LIVE)
PAYMENT_PROVIDER=mock

# Stripe credentials (required when PAYMENT_PROVIDER=stripe)
# Obtain from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook signing secret — from Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Generic payment webhook HMAC secret (non-Stripe providers)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=

# bit payment integration (NOT YET LIVE — requires onboarding with bit Israel)
# See docs/PAYMENT_PROVIDER_ONBOARDING.md for onboarding instructions
# Enable only after completing bit merchant onboarding:
ENABLE_BIT_PAYMENT=false
BIT_API_KEY=
BIT_MERCHANT_ID=
BIT_ENVIRONMENT=sandbox

# PayBox payment integration (NOT YET LIVE — requires onboarding with PayBox)
# See docs/PAYMENT_PROVIDER_ONBOARDING.md for onboarding instructions
# Enable only after completing PayBox merchant onboarding:
ENABLE_PAYBOX_PAYMENT=false
PAYBOX_TERMINAL=
PAYBOX_API_KEY=
PAYBOX_ENVIRONMENT=sandbox

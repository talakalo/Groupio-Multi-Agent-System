# Groupio Web App Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Standalone admin app (port 3001 in local monorepo)
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# WhatsApp Integration (optional)
NEXT_PUBLIC_WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_PHONE=

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ──────────────────────────────────────────────────────────────────────────────
# PostHog Analytics (required when NEXT_PUBLIC_ENABLE_ANALYTICS=true)
# Obtain from: https://app.posthog.com → Project Settings → Project API Key
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Locale Settings
NEXT_PUBLIC_DEFAULT_LOCALE=he
NEXT_PUBLIC_SUPPORTED_LOCALES=he,en

# ──────────────────────────────────────────────────────────────────────────────
# Payment — Stripe (required when backend PAYMENT_PROVIDER=stripe)
# ──────────────────────────────────────────────────────────────────────────────
# Obtain from: https://dashboard.stripe.com/apikeys
# Use the PUBLISHABLE key only — never the secret key on the frontend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ──────────────────────────────────────────────────────────────────────────────
# Payment — bit (NOT YET LIVE — see docs/PAYMENT_PROVIDER_ONBOARDING.md)
# Set to "true" only after completing bit merchant onboarding
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BIT_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────────
# Payment — PayBox (NOT YET LIVE — see docs/PAYMENT_PROVIDER_ONBOARDING.md)
# Set to "true" only after completing PayBox merchant onboarding
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYBOX_ENABLED=false

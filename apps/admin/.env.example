# Groupio Admin Dashboard Environment Variables

# API Configuration
# Admin pages call this backend; it must use the SAME database you seeded (API DATABASE_URL / Supabase).
# Must be the FastAPI host (uvicorn), NOT this Next app. Wrong: http://localhost:3001 — that returns HTML 404 for /api/v1/...
# Use the same host as login (do not mix localhost vs 127.0.0.1) or auth cookies won't match → 401 on API calls.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication (Admin-specific)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
ADMIN_ALLOWED_EMAILS=admin@groupio.co.il

# Monitoring
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002

# Feature Flags
NEXT_PUBLIC_ENABLE_AGENT_CONFIG=true
NEXT_PUBLIC_ENABLE_LIVE_METRICS=true
NEXT_PUBLIC_ENABLE_ESCALATION_QUEUE=true

# PostHog Analytics (same project key as web app — use same key from https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

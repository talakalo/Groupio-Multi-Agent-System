{
  "name": "@groupio/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "maestro test .maestro/flows",
    "test:e2e:android": "maestro test --platform android .maestro/flows",
    "test:e2e:ios": "maestro test --platform ios .maestro/flows",
    "test:e2e:auth": "maestro test .maestro/flows/01-auth",
    "test:e2e:resident": "maestro test .maestro/flows/02-resident",
    "test:e2e:contractor": "maestro test .maestro/flows/03-contractor",
    "test:e2e:smoke": "maestro test --include-tags smoke .maestro/flows",
    "test:e2e:cloud": "maestro cloud --apiKey $MAESTRO_CLOUD_API_KEY .maestro/flows"
  },
  "dependencies": {
    "@groupio/api-client": "workspace:*",
    "@groupio/types": "workspace:*",
    "@groupio/utils": "workspace:*",
    "@stripe/stripe-react-native": "0.38.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-navigation/native": "^6.1.18",
    "@tanstack/react-query": "^5.51.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-device": "~6.0.0",
    "expo-document-picker": "~12.0.0",
    "expo-font": "~12.0.0",
    "expo-image-picker": "~15.0.0",
    "expo-linking": "~6.3.0",
    "expo-localization": "~15.0.0",
    "expo-notifications": "~0.28.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "i18n-js": "^4.5.3",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-paper": "^5.12.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-vector-icons": "^10.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.5.0",
    "@types/react": "~18.2.79",
    "@types/react-native-vector-icons": "^6.4.18",
    "@vitejs/plugin-react": "^4.3.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}

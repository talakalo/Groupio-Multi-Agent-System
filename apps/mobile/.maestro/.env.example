# Copy this file to .maestro/.env and fill in real values for your environment.
# The .env file is gitignored; commit only .env.example.

# App bundle identifier (same for iOS and Android)
APP_ID=com.groupio.app

# Resident test account (must exist in the backend's test/staging database)
TEST_RESIDENT_EMAIL=e2e.resident@test.groupio.co.il
TEST_RESIDENT_PASSWORD=E2eResident123!
TEST_RESIDENT_NAME=E2E Resident

# Contractor test account
TEST_CONTRACTOR_EMAIL=e2e.contractor@test.groupio.co.il
TEST_CONTRACTOR_PASSWORD=E2eContractor123!
TEST_CONTRACTOR_NAME=E2E Contractor

# Backend API base URL
# Android emulator: use 10.0.2.2 for host machine localhost
# iOS simulator: use localhost
API_BASE_URL=http://localhost:8000
# Resend is configured on the API server (docker/.env or root .env as RESEND_API_KEY), not in Maestro.
RESEND_API_KEY=re_DofGfESv_9cXRwKUrYToLJDnFJS6tM8Rb
SMTP_FROM_EMAIL=noreply@groupio   # or your verified domain address
SMTP_FROM_NAME=Groupio
FRONTEND_URL=http://localhost:3000      # links in emails must hit your local web app
# ENVIRONMENT=development end is configured on the API server (docker/.env or root .env as RESEND_API_KEY), not in Maestro.
SMTP_FROM_EMAIL=noreply@groupio# or your verified domain address
SMTP_FROM_NAME=Groupio
FRONTEND_URL=http://localhost:3000      # links in emails must hit your local web app
ENVIRONMENT=development   
PINECONE_API_KEY=               
# Dependencies and env (huge – do not send to Docker)
node_modules
**/node_modules
.pnpm-store
venv
.venv
env
.env
.env.*
!.env.example

# Git and IDE
.git
.gitignore
.cursor
.vscode
.idea
*.swp
*.swo

# Build artifacts
__pycache__
**/__pycache__
*.py[cod]
*$py.class
*.so
.Python
build
dist
*.egg-info
.eggs
*.egg

# Test and tooling (not needed in runtime image)
tests
.pytest_cache
.coverage
htmlcov
.mypy_cache
.ruff_cache
.tox
nox

# Docs and tasks
docs
tasks
*.md
!README.md

# Next.js build artifacts (excluded to keep context small; rebuilt in Docker)
apps/**/.next
apps/**/out
apps/**/storybook-static
apps/**/.turbo

# Package build artifacts
packages/**/dist
packages/**/.turbo

# Lockfiles and config not needed at runtime
package-lock.json
uv.lock
.eslintrc.js
.prettierrc
.pre-commit-config.yaml
.github
.trivyignore

# Keep only what the Dockerfile copies
# (src/, requirements*.txt, pyproject.toml)
